PORT=7443
HOST=0.0.0.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
# Mesh is the default: client-to-client encryption, direct UDP and opaque WSS relay.
TUNNEL_MODE=mesh
MESH_UDP_PORT=51821
# Built-in authenticated STUN uses the mesh UDP port (no extra listener).
# No third-party STUN endpoints are contacted by Remote Print clients.
# Optional public hostname for UDP discovery if different from the API hostname.
# MESH_PUBLIC_HOST=print.example.com
# Legacy hub only (TUNNEL_MODE=legacy). Both settings below must be set together.
# These settings alone do not start a tunnel or configure forwarding/firewall rules.
# TUNNEL_ENDPOINT=vpn.example.com:51820
# TUNNEL_SERVER_PUBLIC_KEY=<base64 WireGuard public key>
# Set both paths to serve HTTPS directly. For production, a TLS reverse proxy is also suitable.
# TLS_CERT_PATH=./certs/server.crt
# TLS_KEY_PATH=./certs/server.key
# TRUST_PROXY=1
# Optional canonical public HTTPS origin embedded into setup downloads.
# Otherwise use the request host/protocol (forwarded values require TRUST_PROXY).
# PUBLIC_SERVER_URL=https://print.example.com

