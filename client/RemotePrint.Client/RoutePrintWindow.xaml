<Window x:Class="RemotePrint.Client.RoutePrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn máy in từ xa" Width="720" Height="520" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" Topmost="True"
        FontFamily="Segoe UI" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>
        <Style x:Key="ListChoice" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14,12" CornerRadius="7"
                                Background="#FFFFFF" BorderBrush="#D8DEE9" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="Card" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#3157D5"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="#EEF3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Chọn nơi nhận lệnh in" FontSize="24" FontWeight="Bold" Foreground="#172033"/>
                <TextBlock Text="Chỉ hiển thị các máy đã được duyệt, đang online và ở cùng Room."
                           Margin="0,5,0,0" Foreground="#667085"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="24,18,24,0" Padding="14,11" CornerRadius="7"
                Background="#EAF1FF" BorderBrush="#C8D7FF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tài liệu" FontWeight="SemiBold" Foreground="#3157D5" Margin="0,0,12,0"/>
                <TextBlock x:Name="DocumentText" Foreground="#344054" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="MÁY NHẬN" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="ClientCountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               Foreground="#667085"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <ListBox x:Name="ComputerList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ListChoice}"
                             SelectionChanged="ComputerList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#172033" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PrinterSummary}" Margin="0,4,0,0" Foreground="#667085"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PrinterSummary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="EmptyClientsPanel" Visibility="Collapsed" Background="White"
                            BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="7" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chưa có máy nhận lệnh" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#172033" TextAlignment="Center"/>
                            <TextBlock Text="Hãy mở Remote Print Client trên máy khác, kết nối cùng server, cùng Room và chia sẻ ít nhất một máy in."
                                       Margin="0,8,0,0" Foreground="#667085" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="MÁY IN ĐƯỢC CHIA SẺ" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <ListBox x:Name="PrinterList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ListChoice}"
                             SelectionChanged="PrinterList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="●" Foreground="#3157D5" FontSize="11" Margin="0,2,10,0"/>
                                    <TextBlock Text="{Binding}" FontSize="14" Foreground="#172033"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="EmptyPrintersPanel" Background="White" BorderBrush="#D8DEE9"
                            BorderThickness="1" CornerRadius="7" Padding="20">
                        <TextBlock x:Name="PrinterHintText" Text="Chọn một máy ở bên trái để xem máy in."
                                   Foreground="#667085" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="RefreshButton" Content="↻  Làm mới" Padding="13,8" Click="Refresh_Click"
                            Background="White" BorderBrush="#CBD5E1" Foreground="#344054" Cursor="Hand"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#667085"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Để sau" Style="{StaticResource ActionButton}" Click="Cancel_Click"
                            Background="#FFFFFF" Foreground="#344054" BorderBrush="#CBD5E1"/>
                    <Button x:Name="SendButton" Content="Gửi lệnh in" Style="{StaticResource ActionButton}"
                            Click="Send_Click" Background="#3157D5" Foreground="White" BorderBrush="#3157D5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
