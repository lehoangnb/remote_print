<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>RemotePrint.Client.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>remote-print.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="remote-print.ico" />
    <Content Include="../../server/public/translations.json" Link="translations.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../RemotePrint.Core/RemotePrint.Core.csproj" />
    <Compile Remove="Models.cs;RemotePrintApi.cs;PrinterService.cs;ConfigService.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="MainForm.cs;DeviceConfigForm.cs;SetupNoticeForm.cs;InstalledPrintersForm.cs;TestPrintFilesForm.cs;UpdateProgressForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Update="DeviceConfigForm.Designer.cs"><DependentUpon>DeviceConfigForm.cs</DependentUpon></Compile>
    <Compile Update="SetupNoticeForm.Designer.cs"><DependentUpon>SetupNoticeForm.cs</DependentUpon></Compile>
    <Compile Update="InstalledPrintersForm.Designer.cs"><DependentUpon>InstalledPrintersForm.cs</DependentUpon></Compile>
    <Compile Update="TestPrintFilesForm.Designer.cs"><DependentUpon>TestPrintFilesForm.cs</DependentUpon></Compile>
    <Compile Update="UpdateProgressForm.Designer.cs"><DependentUpon>UpdateProgressForm.cs</DependentUpon></Compile>
    <Compile Update="MainForm.Updates.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <Compile Update="MainForm.AdminStartup.cs"><DependentUpon>MainForm.cs</DependentUpon></Compile>
    <EmbeddedResource Update="MainForm.resx"><DependentUpon>MainForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="DeviceConfigForm.resx"><DependentUpon>DeviceConfigForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="SetupNoticeForm.resx"><DependentUpon>SetupNoticeForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="InstalledPrintersForm.resx"><DependentUpon>InstalledPrintersForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="TestPrintFilesForm.resx"><DependentUpon>TestPrintFilesForm.cs</DependentUpon></EmbeddedResource>
    <EmbeddedResource Update="UpdateProgressForm.resx"><DependentUpon>UpdateProgressForm.cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- The installer seams (IServiceRegistrar) are exercised
         by the Checks suite with fakes instead of a real service control manager. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RemotePrint.Checks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
